# Copy to .env at the repo root before running docker compose.
# Generate a strong key with: openssl rand -base64 48

# Shared JWT signing key used by the gateway, accounts-service and
# loans-service. Required by docker compose.
JWT_KEY=replace-me-with-a-secret-at-least-32-characters-long

# Credentials used by the gateway's development-only token issuer
# (POST /auth/token). Only used when the gateway runs in Development.
AUTH_CLIENT_SECRET=change-me
