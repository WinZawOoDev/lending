{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "Match": {
          "Path": "/accounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/accounts"
          }
        ]
      },
      "loans-route": {
        "ClusterId": "loans-cluster",
        "Match": {
          "Path": "/loans/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/loans"
          }
        ]
      }
    },
    "Clusters": {
      "accounts-cluster": {
        "Destinations": {
          "accounts-service": {
            "Address": "http://accounts-service:3000/"
          }
        }
      },
      "loans-cluster": {
        "Destinations": {
          "loans-service": {
            "Address": "http://loans-service:8080/"
          }
        }
      }
    }
  }
}
