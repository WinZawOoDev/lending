@loans_service_HostAddress = http://localhost:5120

### List loans
GET {{loans_service_HostAddress}}/loans
Accept: application/json

### Create a loan
POST {{loans_service_HostAddress}}/loans
Content-Type: application/json

{
  "accountId": "5f0b1e2c-3a4d-4b5c-8d9e-0a1b2c3d4e5f",
  "principal": 10000,
  "interestRate": 7.5,
  "termMonths": 24
}

### Get one loan
GET {{loans_service_HostAddress}}/loans/{id}
Accept: application/json

### Update loan status
PATCH {{loans_service_HostAddress}}/loans/{id}
Content-Type: application/json

{
  "status": "Active"
}

### Delete a loan
DELETE {{loans_service_HostAddress}}/loans/{id}

###
