# Copy to .env and adjust as needed.
# Inside docker compose the host is "postgres"; locally it is "localhost".
DATABASE_URL="postgresql://lending:lending@localhost:5432/lending"
RABBITMQ_URL="amqp://lending:lending@localhost:5672"
# JWT authentication (must match the gateway's Auth:Jwt settings).
# The placeholder below is only accepted when NODE_ENV=development.
JWT_KEY="replace-me-with-a-secret-at-least-32-characters-long"
JWT_ISSUER="lending-gateway"
JWT_AUDIENCE="lending-services"
